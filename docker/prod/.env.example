# BEAM Campus — production env for the dedicated box. Copy to .env, fill in.
# NEVER commit .env.

# Required: generate with `mix phx.gen.secret` (64+ chars)
SECRET_KEY_BASE=

# Domain + TLS
PHX_HOST=beam-campus.net
SITE_ADDRESS=beam-campus.net, www.beam-campus.net
ACME_EMAIL=raf.lefever@erlef.org

# Mailgun (optional until the contact form ships). EU region.
BEAM_CAMPUS_MAILGUN_API_KEY=
BEAM_CAMPUS_MAILGUN_DOMAIN=mg.beam-campus.net
BEAM_CAMPUS_MAILGUN_BASE_URL=https://api.eu.mailgun.net
BEAM_CAMPUS_CONTACT_EMAIL=raf.lefever@erlef.org

# ── The mesh readers ────────────────────────────────────────────────────
#
# Three workbench pages subscribe to public realms and draw what arrives:
# Robo Rumble, Biotopes, and A Society. The site never publishes and never
# holds a store.
#
# ⚠ UNSET IS A WORKING SITE, NOT A BROKEN ONE. Each page renders its own
# "not configured" state and says which kind of quiet it is looking at.
# Set the seeds to point at real stations.
#
# A station URL, or several comma-separated. Which door you reach the mesh
# through does not decide what you receive: routing is the mesh's job.
BEAM_CAMPUS_RUMBLE_SEEDS=
BEAM_CAMPUS_BIOTOPE_SEEDS=
BEAM_CAMPUS_SOCIETY_SEEDS=

# The realms are PUBLIC by design and default correctly in runtime.exs, so
# these are only for pointing the site at a different deployment. Each tag is
# the sha256 of its own name, derived rather than issued:
#   net.beamcampus.society = 659ee772...d97cd051
# ⚠ NEVER put the FLEET realm tag here. It routes sentinel sightings and
# warden facts, and this container is public.
BEAM_CAMPUS_RUMBLE_REALM=
BEAM_CAMPUS_BIOTOPE_REALM=
BEAM_CAMPUS_SOCIETY_REALM=

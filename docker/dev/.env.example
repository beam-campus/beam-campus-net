# BEAM Campus — dev environment variables
# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# ── Mailgun (EU region) — for the contact / patron enquiry path ────────────
# https://app.eu.mailgun.com/  →  Sending → Domain settings → API keys
BEAM_CAMPUS_MAILGUN_API_KEY=
BEAM_CAMPUS_MAILGUN_DOMAIN=mg.beam-campus.net
BEAM_CAMPUS_MAILGUN_BASE_URL=https://api.eu.mailgun.net
BEAM_CAMPUS_CONTACT_EMAIL=raf.lefever@erlef.org

# ── Hanko (self-hosted auth) ───────────────────────────────────────────────
HANKO_DB_PASSWORD=hanko

# ── Caddy / TLS (prod only) ────────────────────────────────────────────────
# In dev, leave these unset — Caddy serves https://localhost with an internal
# cert. In prod, set the real domain(s) + ACME email and Caddy provisions
# Let's Encrypt certificates automatically.
# SITE_ADDRESS=beam-campus.net, www.beam-campus.net
# ACME_EMAIL=raf.lefever@erlef.org

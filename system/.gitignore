# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# SQLite databases and their WAL/shared-memory sidecars. The dev and test DBs
# are generated, not source: the `test` alias runs ecto.create + ecto.migrate,
# and `mix setup` runs ecto.setup. The -shm/-wal sidecars in particular are
# rewritten on every test run, so tracking them produces churn in every diff.
*.db
*.db-shm
*.db-wal



# House rule: mix.exs leads, not the lock — don't commit the lockfile.
/mix.lock

# Compiled/served assets (regenerated by `mix assets.build`)
/apps/beam_campus_web/priv/static/assets/

# Local secrets
.env
